{"number-of-islands-ii": [{"line": 1, "text": "class Solution:"}, {"line": 2, "text": "    def numIslands2(self, m, n, positions):"}, {"line": 3, "text": "        parent = {}"}, {"line": 4, "text": "        def find(x): return find(parent[x]) if parent.setdefault(x, x) != x else x"}, {"line": 5, "text": "        def union(x, y):"}, {"line": 6, "text": "            px, py = find(x), find(y)"}, {"line": 7, "text": "            if px != py: parent[px] = py"}, {"line": 8, "text": "        result, islands = [], 0"}, {"line": 9, "text": "        for r, c in positions:"}, {"line": 10, "text": "            islands += 1"}, {"line": 11, "text": "            for dr, dc in [(0,1),(1,0),(0,-1),(-1,0)]:"}, {"line": 12, "text": "                nr, nc = r + dr, c + dc; union((r,c), (nr,nc)) if 0<=nr<m and 0<=nc<n and (nr,nc) in parent else None\n            result.append(len(set(find(p) for p in parent)))\n        return result"}}, "find-right-interval": [{"line": 1, "text": "class Solution:"}, {"line": 2, "text": "    def findRightInterval(self, intervals):"}, {"line": 3, "text": "        import bisect"}, {"line": 4, "text": "        starts = sorted([(v[0], i) for i, v in enumerate(intervals)])"}, {"line": 5, "text": "        result = []"}, {"line": 6, "text": "        for end in [v[1] for v in intervals]:"}, {"line": 7, "text": "            idx = bisect.bisect_left(starts, (end,))"}, {"line": 8, "text": "            result.append(starts[idx][1] if idx < len(starts) else -1)"}, {"line": 9, "text": "        return result"}}, "path-sum-iii": [{"line": 1, "text": "class Solution:"}, {"line": 2, "text": "    def pathSum(self, root, targetSum):"}, {"line": 3, "text": "        from collections import defaultdict"}, {"line": 4, "text": "        count = [0]"}, {"line": 5, "text": "        path_counts = defaultdict(int)"}, {"line": 6, "text": "        def dfs(node, cur_sum):"}, {"line": 7, "text": "            if not node: return"}, {"line": 8, "text": "            cur_sum += node.val"}, {"line": 9, "text": "            count[0] += path_counts[cur_sum - targetSum]"}, {"line": 10, "text": "            path_counts[cur_sum] += 1"}, {"line": 11, "text": "            dfs(node.left, cur_sum); dfs(node.right, cur_sum)"}, {"line": 12, "text": "            path_counts[cur_sum] -= 1\n        dfs(root, 0); return count[0]"}}, "find-all-anagrams-in-string": [{"line": 1, "text": "class Solution:"}, {"line": 2, "text": "    def findAnagrams(self, s, p):"}, {"line": 3, "text": "        from collections import Counter"}, {"line": 4, "text": "        if len(p) > len(s): return []"}, {"line": 5, "text": "        p_count, window = Counter(p), Counter(s[:len(p)])"}, {"line": 6, "text": "        result = [0] if window == p_count else []"}, {"line": 7, "text": "        for i in range(len(p), len(s)):"}, {"line": 8, "text": "            window[s[i]] += 1"}, {"line": 9, "text": "            window[s[i-len(p)]] -= 1; del window[s[i-len(p)]] if window[s[i-len(p)]] == 0 else None"}, {"line": 10, "text": "            if window == p_count: result.append(i - len(p) + 1)"}, {"line": 11, "text": "        return result"}}, "ternary-expression-parser": [{"line": 1, "text": "class Solution:"}, {"line": 2, "text": "    def parseTernary(self, expression):"}, {"line": 3, "text": "        def parse(s, i):"}, {"line": 4, "text": "            ch = s[i]"}, {"line": 5, "text": "            if s[i+1:i+2] != '?': return ch, i+1"}, {"line": 6, "text": "            true_val, i = parse(s, i+2)"}, {"line": 7, "text": "            i += 1"}, {"line": 8, "text": "            false_val, i = parse(s, i)"}, {"line": 9, "text": "            return (true_val if ch == 't' else false_val), i"}, {"line": 10, "text": "        return parse(expression, 0)[0]"}}, "kth-smallest-lexicographical-order": [{"line": 1, "text": "class Solution:"}, {"line": 2, "text": "    def getPermutation(self, n, k):"}, {"line": 3, "text": "        import math"}, {"line": 4, "text": "        nums, result, k = list(range(1, n+1)), [], k-1"}, {"line": 5, "text": "        for i in range(n, 0, -1):"}, {"line": 6, "text": "            idx = k // math.factorial(i-1)"}, {"line": 7, "text": "            result.append(str(nums.pop(idx)))"}, {"line": 8, "text": "            k %= math.factorial(i-1)"}, {"line": 9, "text": "        return ''.join(result)"}}, "arranging-coins": [{"line": 1, "text": "class Solution:"}, {"line": 2, "text": "    def arrangeCoins(self, n):"}, {"line": 3, "text": "        left, right = 0, n"}, {"line": 4, "text": "        while left <= right:"}, {"line": 5, "text": "            mid = (left + right) // 2"}, {"line": 6, "text": "            stairs = mid * (mid + 1) // 2"}, {"line": 7, "text": "            if stairs == n: return mid"}, {"line": 8, "text": "            elif stairs < n: left = mid + 1"}, {"line": 9, "text": "            else: right = mid - 1"}, {"line": 10, "text": "        return right"}}, "find-all-duplicates-in-array": [{"line": 1, "text": "class Solution:"}, {"line": 2, "text": "    def findDuplicates(self, nums):"}, {"line": 3, "text": "        result = []"}, {"line": 4, "text": "        for num in nums:"}, {"line": 5, "text": "            idx = abs(num) - 1"}, {"line": 6, "text": "            if nums[idx] < 0:"}, {"line": 7, "text": "                result.append(abs(num))"}, {"line": 8, "text": "            else:"}, {"line": 9, "text": "                nums[idx] = -nums[idx]"}, {"line": 10, "text": "        return result"}}, "string-compression": [{"line": 1, "text": "class Solution:"}, {"line": 2, "text": "    def compress(self, chars):"}, {"line": 3, "text": "        write, count = 0, 1"}, {"line": 4, "text": "        for read in range(1, len(chars)+1):"}, {"line": 5, "text": "            if read == len(chars) or chars[read] != chars[read-1]:"}, {"line": 6, "text": "                chars[write] = chars[read-1]; write += 1"}, {"line": 7, "text": "                if count > 1:"}, {"line": 8, "text": "                    for d in str(count):"}, {"line": 9, "text": "                        chars[write] = d; write += 1"}, {"line": 10, "text": "                count = 1"}, {"line": 11, "text": "            else: count += 1"}, {"line": 12, "text": "        return write"}}, "sequence-reconstruction": [{"line": 1, "text": "class Solution:"}, {"line": 2, "text": "    def sequenceReconstruction(self, org, seqs):"}, {"line": 3, "text": "        from collections import defaultdict, deque"}, {"line": 4, "text": "        graph, in_degree = defaultdict(set), defaultdict(int)"}, {"line": 5, "text": "        for seq in seqs:"}, {"line": 6, "text": "            for i in range(len(seq)-1):"}, {"line": 7, "text": "                if seq[i+1] not in graph[seq[i]]: graph[seq[i]].add(seq[i+1]); in_degree[seq[i+1]] += 1"}, {"line": 8, "text": "        q = deque([x for x in org if in_degree[x] == 0])"}, {"line": 9, "text": "        result = []"}, {"line": 10, "text": "        while q:"}, {"line": 11, "text": "            if len(q) > 1: return False\n            node = q.popleft(); result.append(node)"}, {"line": 12, "text": "            for nei in graph[node]: in_degree[nei] -= 1; q += [nei] if in_degree[nei] == 0 else []\n        return result == org"}}, "max-consecutive-ones": [{"line": 1, "text": "class Solution:"}, {"line": 2, "text": "    def findMaxConsecutiveOnes(self, nums):"}, {"line": 3, "text": "        max_count, current = 0, 0"}, {"line": 4, "text": "        for num in nums:"}, {"line": 5, "text": "            current = current + 1 if num == 1 else 0"}, {"line": 6, "text": "            max_count = max(max_count, current)"}, {"line": 7, "text": "        return max_count"}}, "count-the-repetitions": [{"line": 1, "text": "class Solution:"}, {"line": 2, "text": "    def getMaxRepetitions(self, s1, n1, s2, n2):"}, {"line": 3, "text": "        s1_count = s2_count = s2_idx = 0"}, {"line": 4, "text": "        s1_count_at_s2 = {0: 0}"}, {"line": 5, "text": "        for i in range(n1):"}, {"line": 6, "text": "            for ch in s1:"}, {"line": 7, "text": "                if ch == s2[s2_idx]: s2_idx += 1\n            if s2_idx == len(s2): s2_count += 1; s2_idx = 0"}, {"line": 8, "text": "            s1_count += 1"}, {"line": 9, "text": "            if s2_count % n2 == 0 and s2_idx == 0:"}, {"line": 10, "text": "                if s1_count in s1_count_at_s2: return (s1_count * (n1 // s1_count) - s1_count_at_s2[s1_count]) // n2\n            s1_count_at_s2[s1_count] = s2_count"}, {"line": 11, "text": "        return s2_count // n2"}}, "unique-substrings-in-wraparound-string": [{"line": 1, "text": "class Solution:"}, {"line": 2, "text": "    def findSubstringInWraproundString(self, s):"}, {"line": 3, "text": "        last_pos = {}"}, {"line": 4, "text": "        length = 1"}, {"line": 5, "text": "        for i in range(len(s)):"}, {"line": 6, "text": "            if i > 0 and (ord(s[i]) - ord(s[i-1])) % 26 == 1:"}, {"line": 7, "text": "                length += 1"}, {"line": 8, "text": "            else:"}, {"line": 9, "text": "                length = 1"}, {"line": 10, "text": "            last_pos[s[i]] = max(last_pos.get(s[i], 0), length)"}, {"line": 11, "text": "        return sum(last_pos.values())"}}, "validate-ip-address": [{"line": 1, "text": "class Solution:"}, {"line": 2, "text": "    def validIPAddress(self, IP):"}, {"line": 3, "text": "        if '.' in IP:"}, {"line": 4, "text": "            parts = IP.split('.')"}, {"line": 5, "text": "            if len(parts) != 4: return 'Neither'"}, {"line": 6, "text": "            for p in parts:"}, {"line": 7, "text": "                if not p or not p.isdigit() or int(p) > 255 or (len(p) > 1 and p[0] == '0'): return 'Neither'"}, {"line": 8, "text": "            return 'IPv4'"}, {"line": 9, "text": "        elif ':' in IP:"}, {"line": 10, "text": "            parts = IP.split(':')"}, {"line": 11, "text": "            if len(parts) != 8: return 'Neither'\n            for p in parts:\n                if not p or len(p) > 4 or not all(c in '0123456789abcdefABCDEF' for c in p): return 'Neither'\n            return 'IPv6'"}, {"line": 12, "text": "        return 'Neither'"}}, "convex-polygon": [{"line": 1, "text": "class Solution:"}, {"line": 2, "text": "    def isConvexPolygon(self, points):"}, {"line": 3, "text": "        if len(points) < 3: return False"}, {"line": 4, "text": "        def cross(o, a, b): return (a[0]-o[0])*(b[1]-o[1]) - (a[1]-o[1])*(b[0]-o[0])"}, {"line": 5, "text": "        n = len(points); sign = None"}, {"line": 6, "text": "        for i in range(n):"}, {"line": 7, "text": "            cp = cross(points[i], points[(i+1)%n], points[(i+2)%n])"}, {"line": 8, "text": "            if cp != 0:"}, {"line": 9, "text": "                if sign is None: sign = cp > 0"}, {"line": 10, "text": "                elif (cp > 0) != sign: return False"}, {"line": 11, "text": "        return True"}}, "implement-rand10": [{"line": 1, "text": "class Solution:"}, {"line": 2, "text": "    def rand10(self):"}, {"line": 3, "text": "        while True:"}, {"line": 4, "text": "            row = rand7()"}, {"line": 5, "text": "            col = rand7()"}, {"line": 6, "text": "            idx = (row - 1) * 7 + col"}, {"line": 7, "text": "            if idx <= 40: return idx % 10 + 1"}}, "encode-string-with-shortest-length": [{"line": 1, "text": "class Solution:"}, {"line": 2, "text": "    def minimumLengthEncoding(self, words):"}, {"line": 3, "text": "        words = set(words)"}, {"line": 4, "text": "        words = [w for w in words if not any(w.endswith(v) and w != v for v in words)]"}, {"line": 5, "text": "        return len('#'.join(words)) + 1"}}, "concatenated-words": [{"line": 1, "text": "class Solution:"}, {"line": 2, "text": "    def findConcatenatedWords(self, words):"}, {"line": 3, "text": "        word_set, result = set(words), []"}, {"line": 4, "text": "        def can_form(word, start=0, count=0):"}, {"line": 5, "text": "            if start == len(word): return count >= 2"}, {"line": 6, "text": "            for end in range(start+1, len(word)+1):"}, {"line": 7, "text": "                if word[start:end] in word_set and can_form(word, end, count+1): return True"}, {"line": 8, "text": "            return False"}, {"line": 9, "text": "        for w in words:"}, {"line": 10, "text": "            word_set.discard(w)"}, {"line": 11, "text": "            if can_form(w): result.append(w)"}, {"line": 12, "text": "            word_set.add(w)\n        return result"}}, "matchsticks-to-square": [{"line": 1, "text": "class Solution:"}, {"line": 2, "text": "    def makesquare(self, matchsticks):"}, {"line": 3, "text": "        if sum(matchsticks) % 4 or max(matchsticks) > sum(matchsticks) // 4: return False"}, {"line": 4, "text": "        sides = [0] * 4"}, {"line": 5, "text": "        matchsticks.sort(reverse=True)"}, {"line": 6, "text": "        def backtrack(i):"}, {"line": 7, "text": "            if i == len(matchsticks): return all(s == sides[0] for s in sides)"}, {"line": 8, "text": "            for j in range(4):"}, {"line": 9, "text": "                sides[j] += matchsticks[i]"}, {"line": 10, "text": "                if sides[j] <= sides[0] and backtrack(i+1): return True"}, {"line": 11, "text": "                sides[j] -= matchsticks[i]"}, {"line": 12, "text": "            return False\n        return backtrack(0)"}}, "ones-and-zeroes": [{"line": 1, "text": "class Solution:"}, {"line": 2, "text": "    def findMaxForm(self, strs, m, n):"}, {"line": 3, "text": "        dp = [[0]*(n+1) for _ in range(m+1)]"}, {"line": 4, "text": "        for s in strs:"}, {"line": 5, "text": "            zeros, ones = s.count('0'), s.count('1')"}, {"line": 6, "text": "            for i in range(m, zeros-1, -1):"}, {"line": 7, "text": "                for j in range(n, ones-1, -1):"}, {"line": 8, "text": "                    dp[i][j] = max(dp[i][j], dp[i-zeros][j-ones]+1)"}, {"line": 9, "text": "        return dp[m][n]"}}, "heaters": [{"line": 1, "text": "class Solution:"}, {"line": 2, "text": "    def findRadius(self, houses, heaters):"}, {"line": 3, "text": "        import bisect"}, {"line": 4, "text": "        heaters.sort()"}, {"line": 5, "text": "        max_radius = 0"}, {"line": 6, "text": "        for house in houses:"}, {"line": 7, "text": "            idx = bisect.bisect_left(heaters, house)"}, {"line": 8, "text": "            left_dist = house - heaters[idx-1] if idx > 0 else float('inf')"}, {"line": 9, "text": "            right_dist = heaters[idx] - house if idx < len(heaters) else float('inf')"}, {"line": 10, "text": "            max_radius = max(max_radius, min(left_dist, right_dist))"}, {"line": 11, "text": "        return max_radius"}}, "number-complement": [{"line": 1, "text": "class Solution:"}, {"line": 2, "text": "    def findComplement(self, num):"}, {"line": 3, "text": "        mask = (1 << num.bit_length()) - 1"}, {"line": 4, "text": "        return num ^ mask"}}, "total-hamming-distance": [{"line": 1, "text": "class Solution:"}, {"line": 2, "text": "    def totalHammingDistance(self, nums):"}, {"line": 3, "text": "        total = 0"}, {"line": 4, "text": "        for i in range(32):"}, {"line": 5, "text": "            count = sum((num >> i) & 1 for num in nums)"}, {"line": 6, "text": "            total += count * (len(nums) - count)"}, {"line": 7, "text": "        return total"}}, "generate-random-point-in-a-circle": [{"line": 1, "text": "class Solution:"}, {"line": 2, "text": "    def __init__(self, radius, x_center, y_center):"}, {"line": 3, "text": "        self.radius, self.x, self.y = radius, x_center, y_center"}, {"line": 4, "text": "    def randPoint(self):"}, {"line": 5, "text": "        import random, math"}, {"line": 6, "text": "        r = self.radius * math.sqrt(random.random())"}, {"line": 7, "text": "        theta = random.random() * 2 * math.pi"}, {"line": 8, "text": "        return [self.x + r * math.cos(theta), self.y + r * math.sin(theta)]"}}, "largest-palindrome-product": [{"line": 1, "text": "class Solution:"}, {"line": 2, "text": "    def largestPalindrome(self, n):"}, {"line": 3, "text": "        if n == 1: return 9"}, {"line": 4, "text": "        upper = 10**n - 1"}, {"line": 5, "text": "        lower = 10**(n-1)"}, {"line": 6, "text": "        for i in range(upper, lower-1, -1):"}, {"line": 7, "text": "            for j in range(upper, lower-1, -1):"}, {"line": 8, "text": "                prod = i * j"}, {"line": 9, "text": "                if str(prod) == str(prod)[::-1]: return prod % (10**9 + 7)"}, {"line": 10, "text": "        return 0"}}, "sliding-window-median": [{"line": 1, "text": "class Solution:"}, {"line": 2, "text": "    def medianSlidingWindow(self, nums, k):"}, {"line": 3, "text": "        from bisect import insort, bisect_left"}, {"line": 4, "text": "        window, result = [], []"}, {"line": 5, "text": "        for i in range(len(nums)):"}, {"line": 6, "text": "            if len(window) == k: window.pop(bisect_left(window, nums[i-k]))"}, {"line": 7, "text": "            insort(window, nums[i])"}, {"line": 8, "text": "            if i >= k - 1:"}, {"line": 9, "text": "                mid = (k - 1) // 2"}, {"line": 10, "text": "                result.append(window[mid] if k % 2 else (window[mid] + window[mid+1]) / 2)"}, {"line": 11, "text": "        return result"}}, "magical-string": [{"line": 1, "text": "class Solution:"}, {"line": 2, "text": "    def magicalString(self, n):"}, {"line": 3, "text": "        s = [1, 2, 2]"}, {"line": 4, "text": "        i, num = 2, 1"}, {"line": 5, "text": "        while len(s) < n:"}, {"line": 6, "text": "            num = 3 - num"}, {"line": 7, "text": "            s.extend([num] * s[i])"}, {"line": 8, "text": "            i += 1"}, {"line": 9, "text": "        return sum(1 for x in s[:n] if x == 1)"}}, "license-key-formatting": [{"line": 1, "text": "class Solution:"}, {"line": 2, "text": "    def licenseKeyFormatting(self, S, K):"}, {"line": 3, "text": "        s = S.replace('-', '').upper()"}, {"line": 4, "text": "        if not s: return ''"}, {"line": 5, "text": "        result = []"}, {"line": 6, "text": "        for i, ch in enumerate(reversed(s)):"}, {"line": 7, "text": "            if i and i % K == 0: result.append('-')"}, {"line": 8, "text": "            result.append(ch)"}, {"line": 9, "text": "        return ''.join(reversed(result))"}}, "smallest-good-base": [{"line": 1, "text": "class Solution:"}, {"line": 2, "text": "    def smallestGoodBase(self, n_str):"}, {"line": 3, "text": "        n = int(n_str)"}, {"line": 4, "text": "        for num_digits in range(60, 0, -1):"}, {"line": 5, "text": "            base = int(n ** (1.0 / (num_digits - 1)))"}, {"line": 6, "text": "            for b in [base - 1, base, base + 1]:"}, {"line": 7, "text": "                if 2 <= b and (b ** num_digits - 1) // (b - 1) == n: return str(b)"}, {"line": 8, "text": "        return str(n - 1)"}}, "find-permutation": [{"line": 1, "text": "class Solution:"}, {"line": 2, "text": "    def findPermutation(self, s):"}, {"line": 3, "text": "        result = list(range(1, len(s) + 2))"}, {"line": 4, "text": "        i = 0"}, {"line": 5, "text": "        while i < len(s):"}, {"line": 6, "text": "            j = i"}, {"line": 7, "text": "            while j < len(s) and s[j] == 'D': j += 1"}, {"line": 8, "text": "            result[i:j+1] = reversed(result[i:j+1])"}, {"line": 9, "text": "            i = j + 1"}, {"line": 10, "text": "        return result"}}, "predict-the-winner": [{"line": 1, "text": "class Solution:"}, {"line": 2, "text": "    def PredictTheWinner(self, nums):"}, {"line": 3, "text": "        memo = {}"}, {"line": 4, "text": "        def dp(i, j):"}, {"line": 5, "text": "            if (i, j) in memo: return memo[(i, j)]"}, {"line": 6, "text": "            if i == j: return nums[i]"}, {"line": 7, "text": "            pick_left = nums[i] - dp(i+1, j)"}, {"line": 8, "text": "            pick_right = nums[j] - dp(i, j-1)"}, {"line": 9, "text": "            memo[(i, j)] = max(pick_left, pick_right)"}, {"line": 10, "text": "            return memo[(i, j)]"}, {"line": 11, "text": "        return dp(0, len(nums)-1) >= 0"}}, "max-consecutive-ones-iii": [{"line": 1, "text": "class Solution:"}, {"line": 2, "text": "    def longestOnes(self, nums, k):"}, {"line": 3, "text": "        left, zeros = 0, 0"}, {"line": 4, "text": "        for right in range(len(nums)):"}, {"line": 5, "text": "            if nums[right] == 0: zeros += 1"}, {"line": 6, "text": "            if zeros > k:"}, {"line": 7, "text": "                if nums[left] == 0: zeros -= 1"}, {"line": 8, "text": "                left += 1"}, {"line": 9, "text": "        return right - left + 1"}}, "zuma-game": [{"line": 1, "text": "class Solution:"}, {"line": 2, "text": "    def findMinStep(self, board, hand):"}, {"line": 3, "text": "        from functools import lru_cache"}, {"line": 4, "text": "        @lru_cache(None)"}, {"line": 5, "text": "        def dfs(b, h):"}, {"line": 6, "text": "            b = b.strip('0')"}, {"line": 7, "text": "            if not b: return 0"}, {"line": 8, "text": "            if not h: return -1"}, {"line": 9, "text": "            res = -1"}, {"line": 10, "text": "            for i in range(len(h)):"}, {"line": 11, "text": "                for j in range(len(b)):"}, {"line": 12, "text": "                    if b[j] == h[i]: tmp = dfs(b[:j] + h[:i] + h[i+1:] + b[j:], h[:i]+h[i+1:]); res = tmp + 1 if tmp >= 0 else res\n            return res\n        return dfs(board, ''.join(sorted(hand)))"}}, "robot-room-cleaner": [{"line": 1, "text": "class Solution:"}, {"line": 2, "text": "    def cleanRoom(self, robot):"}, {"line": 3, "text": "        visited = set()"}, {"line": 4, "text": "        directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]"}, {"line": 5, "text": "        direction_idx = [0]"}, {"line": 6, "text": "        def dfs(r, c):"}, {"line": 7, "text": "            robot.clean()"}, {"line": 8, "text": "            visited.add((r, c))"}, {"line": 9, "text": "            for _ in range(4):"}, {"line": 10, "text": "                dr, dc = directions[direction_idx[0]]"}, {"line": 11, "text": "                nr, nc = r + dr, c + dc"}, {"line": 12, "text": "                if (nr, nc) not in visited: dfs(nr, nc); robot.turnRight(); direction_idx[0] = (direction_idx[0] + 1) % 4\n            robot.turnRight(); direction_idx[0] = (direction_idx[0] + 1) % 4"}}, "the-maze": [{"line": 1, "text": "class Solution:"}, {"line": 2, "text": "    def hasPath(self, maze, start, destination):"}, {"line": 3, "text": "        from collections import deque"}, {"line": 4, "text": "        q, visited = deque([start]), set([tuple(start)])"}, {"line": 5, "text": "        m, n = len(maze), len(maze[0])"}, {"line": 6, "text": "        while q:"}, {"line": 7, "text": "            r, c = q.popleft()"}, {"line": 8, "text": "            if [r, c] == destination: return True"}, {"line": 9, "text": "            for dr, dc in [(0,1),(1,0),(0,-1),(-1,0)]:"}, {"line": 10, "text": "                nr, nc = r + dr, c + dc"}, {"line": 11, "text": "                while 0 <= nr < m and 0 <= nc < n and maze[nr][nc] == 0: nr, nc = nr + dr, nc + dc\n                nr, nc = nr - dr, nc - dc"}, {"line": 12, "text": "                if (nr, nc) not in visited: visited.add((nr, nc)); q.append([nr, nc])\n        return False"}}, "increasing-subsequences": [{"line": 1, "text": "class Solution:"}, {"line": 2, "text": "    def findIncreasingSubsequences(self, nums):"}, {"line": 3, "text": "        result = []"}, {"line": 4, "text": "        def backtrack(start, path):"}, {"line": 5, "text": "            if len(path) >= 2: result.append(list(path))"}, {"line": 6, "text": "            seen = set()"}, {"line": 7, "text": "            for i in range(start, len(nums)):"}, {"line": 8, "text": "                if nums[i] not in seen and (not path or nums[i] >= path[-1]):"}, {"line": 9, "text": "                    seen.add(nums[i])"}, {"line": 10, "text": "                    path.append(nums[i])"}, {"line": 11, "text": "                    backtrack(i+1, path)"}, {"line": 12, "text": "                    path.pop()\n        backtrack(0, []); return result"}}, "construct-the-rectangle": [{"line": 1, "text": "class Solution:"}, {"line": 2, "text": "    def constructRectangle(self, area):"}, {"line": 3, "text": "        w = int(area ** 0.5)"}, {"line": 4, "text": "        while area % w: w -= 1"}, {"line": 5, "text": "        return [area // w, w]"}}, "reverse-pairs": [{"line": 1, "text": "class Solution:"}, {"line": 2, "text": "    def reversePairs(self, nums):"}, {"line": 3, "text": "        def merge_count(arr):"}, {"line": 4, "text": "            if len(arr) <= 1: return arr, 0"}, {"line": 5, "text": "            mid = len(arr) // 2"}, {"line": 6, "text": "            left, lc = merge_count(arr[:mid])"}, {"line": 7, "text": "            right, rc = merge_count(arr[mid:])"}, {"line": 8, "text": "            count = lc + rc; i = j = 0"}, {"line": 9, "text": "            while i < len(left) and j < len(right): count += len(left) - i if left[i] > 2*right[j] else 0; j += 1\n            left[:] = sorted([*left, *right]); return left, count"}, {"line": 10, "text": "        _, result = merge_count(nums); return result"}}, "target-sum": [{"line": 1, "text": "class Solution:"}, {"line": 2, "text": "    def findTargetSumWays(self, nums, target):"}, {"line": 3, "text": "        total = sum(nums)"}, {"line": 4, "text": "        if abs(target) > total or (total + target) % 2: return 0"}, {"line": 5, "text": "        s = (total + target) // 2"}, {"line": 6, "text": "        dp = [0] * (s + 1)"}, {"line": 7, "text": "        dp[0] = 1"}, {"line": 8, "text": "        for num in nums:"}, {"line": 9, "text": "            for i in range(s, num - 1, -1):"}, {"line": 10, "text": "                dp[i] += dp[i - num]"}, {"line": 11, "text": "        return dp[s]"}}, "teemo-attacking": [{"line": 1, "text": "class Solution:"}, {"line": 2, "text": "    def findPoisonedDuration(self, timeSeries, duration):"}, {"line": 3, "text": "        if not timeSeries: return 0"}, {"line": 4, "text": "        total = 0"}, {"line": 5, "text": "        for i in range(len(timeSeries) - 1):"}, {"line": 6, "text": "            total += min(duration, timeSeries[i+1] - timeSeries[i])"}, {"line": 7, "text": "        return total + duration"}}, "next-greater-element-i": [{"line": 1, "text": "class Solution:"}, {"line": 2, "text": "    def nextGreaterElement(self, nums1, nums2):"}, {"line": 3, "text": "        stack, mp = [], {}"}, {"line": 4, "text": "        for num in nums2:"}, {"line": 5, "text": "            while stack and stack[-1] < num:"}, {"line": 6, "text": "                mp[stack.pop()] = num"}, {"line": 7, "text": "            stack.append(num)"}, {"line": 8, "text": "        return [mp.get(num, -1) for num in nums1]"}}, "random-point-in-non-overlapping-rectangles": [{"line": 1, "text": "class Solution:"}, {"line": 2, "text": "    def __init__(self, rects):"}, {"line": 3, "text": "        self.rects = rects"}, {"line": 4, "text": "        self.areas = []; area = 0"}, {"line": 5, "text": "        for x1, y1, x2, y2 in rects: area += (x2 - x1 + 1) * (y2 - y1 + 1); self.areas.append(area)"}, {"line": 6, "text": "    def pick(self):"}, {"line": 7, "text": "        import random, bisect"}, {"line": 8, "text": "        idx = bisect.bisect_left(self.areas, random.randint(1, self.areas[-1]))"}, {"line": 9, "text": "        x1, y1, x2, y2 = self.rects[idx]"}, {"line": 10, "text": "        return [random.randint(x1, x2), random.randint(y1, y2)]"}}, "diagonal-traverse": [{"line": 1, "text": "class Solution:"}, {"line": 2, "text": "    def findDiagonalOrder(self, mat):"}, {"line": 3, "text": "        if not mat: return []"}, {"line": 4, "text": "        result, m, n = [], len(mat), len(mat[0])"}, {"line": 5, "text": "        for d in range(m + n - 1):"}, {"line": 6, "text": "            if d % 2 == 0:"}, {"line": 7, "text": "                for i in range(max(0, d - n + 1), min(m, d + 1)): result.append(mat[i][d - i])"}, {"line": 8, "text": "            else:"}, {"line": 9, "text": "                for i in range(min(m, d + 1) - 1, max(-1, d - n) - 1, -1): result.append(mat[i][d - i])"}, {"line": 10, "text": "        return result"}}, "the-maze-iii": [{"line": 1, "text": "class Solution:"}, {"line": 2, "text": "    def findShortestWay(self, maze, ball, hole):"}, {"line": 3, "text": "        from collections import deque"}, {"line": 4, "text": "        q = deque([(ball[0], ball[1], 0, '')])"}, {"line": 5, "text": "        visited = {(ball[0], ball[1]): (0, '')}"}, {"line": 6, "text": "        m, n = len(maze), len(maze[0])"}, {"line": 7, "text": "        dirs = {'d': (1, 0), 'l': (0, -1), 'r': (0, 1), 'u': (-1, 0)}"}, {"line": 8, "text": "        while q:"}, {"line": 9, "text": "            r, c, dist, path = q.popleft()"}, {"line": 10, "text": "            for direction, (dr, dc) in dirs.items():"}, {"line": 11, "text": "                nr, nc, nd = r, c, dist"}, {"line": 12, "text": "                while 0 <= nr+dr < m and 0 <= nc+dc < n and maze[nr+dr][nc+dc] == 0: nr += dr; nc += dc; nd += 1\n        return visited.get(tuple(hole), 'impossible')[1]"}}, "random-flip-matrix": [{"line": 1, "text": "class Solution:"}, {"line": 2, "text": "    def __init__(self, m, n):"}, {"line": 3, "text": "        self.m, self.n = m, n"}, {"line": 4, "text": "        self.map = {}"}, {"line": 5, "text": "    def flip(self):"}, {"line": 6, "text": "        import random"}, {"line": 7, "text": "        while True:"}, {"line": 8, "text": "            r, c = random.randint(0, self.m-1), random.randint(0, self.n-1)"}, {"line": 9, "text": "            if (r, c) not in self.map:"}, {"line": 10, "text": "                self.map[(r, c)] = True; return [r, c]"}, {"line": 11, "text": "    def reset(self):"}, {"line": 12, "text": "        self.map.clear()"}}, "regular-expression-matching": [{"line": 1, "text": "class Solution:"}, {"line": 2, "text": "    def isMatch(self, s, p):"}, {"line": 3, "text": "        dp = [[False] * (len(p) + 1) for _ in range(len(s) + 1)]"}, {"line": 4, "text": "        dp[0][0] = True"}, {"line": 5, "text": "        for j in range(2, len(p) + 1):"}, {"line": 6, "text": "            if p[j-1] == '*': dp[0][j] = dp[0][j-2]"}, {"line": 7, "text": "        for i in range(1, len(s) + 1):"}, {"line": 8, "text": "            for j in range(1, len(p) + 1):"}, {"line": 9, "text": "                if p[j-1] == '*': dp[i][j] = dp[i][j-2] or (dp[i-1][j] if p[j-2] == '.' or p[j-2] == s[i-1] else False)"}, {"line": 10, "text": "                else: dp[i][j] = dp[i-1][j-1] if (p[j-1] == '.' or p[j-1] == s[i-1]) else False"}, {"line": 11, "text": "        return dp[len(s)][len(p)]"}}, "relative-ranks": [{"line": 1, "text": "class Solution:"}, {"line": 2, "text": "    def findRelativeRanks(self, score):"}, {"line": 3, "text": "        sorted_idx = sorted(range(len(score)), key=lambda i: -score[i])"}, {"line": 4, "text": "        result = [''] * len(score)"}, {"line": 5, "text": "        medals = ['Gold Medal', 'Silver Medal', 'Bronze Medal']"}, {"line": 6, "text": "        for rank, idx in enumerate(sorted_idx):"}, {"line": 7, "text": "            result[idx] = medals[rank] if rank < 3 else str(rank + 1)"}, {"line": 8, "text": "        return result"}}, "scramble-string": [{"line": 1, "text": "class Solution:"}, {"line": 2, "text": "    def isScramble(self, s1, s2):"}, {"line": 3, "text": "        memo = {}"}, {"line": 4, "text": "        def helper(s1, s2):"}, {"line": 5, "text": "            if (s1, s2) in memo: return memo[(s1, s2)]"}, {"line": 6, "text": "            if s1 == s2: return True"}, {"line": 7, "text": "            if sorted(s1) != sorted(s2): return False"}, {"line": 8, "text": "            n = len(s1)"}, {"line": 9, "text": "            for i in range(1, n):"}, {"line": 10, "text": "                if (helper(s1[:i], s2[:i]) and helper(s1[i:], s2[i:])) or (helper(s1[:i], s2[-i:]) and helper(s1[i:], s2[:-i])): memo[(s1,s2)] = True; return True"}, {"line": 11, "text": "            memo[(s1, s2)] = False; return False"}, {"line": 12, "text": "        return helper(s1, s2)"}}, "search-a-2d-matrix": [{"line": 1, "text": "class Solution:"}, {"line": 2, "text": "    def searchMatrix(self, matrix, target):"}, {"line": 3, "text": "        if not matrix: return False"}, {"line": 4, "text": "        m, n = len(matrix), len(matrix[0])"}, {"line": 5, "text": "        left, right = 0, m * n - 1"}, {"line": 6, "text": "        while left <= right:"}, {"line": 7, "text": "            mid = (left + right) // 2"}, {"line": 8, "text": "            val = matrix[mid // n][mid % n]"}, {"line": 9, "text": "            if val == target: return True"}, {"line": 10, "text": "            elif val < target: left = mid + 1"}, {"line": 11, "text": "            else: right = mid - 1"}, {"line": 12, "text": "        return False"}}, "super-washing-machines": [{"line": 1, "text": "class Solution:"}, {"line": 2, "text": "    def findMinMoves(self, machines):"}, {"line": 3, "text": "        total = sum(machines)"}, {"line": 4, "text": "        if total % len(machines): return -1"}, {"line": 5, "text": "        target = total // len(machines)"}, {"line": 6, "text": "        max_moves = 0; left_sum = 0"}, {"line": 7, "text": "        for i, m in enumerate(machines):"}, {"line": 8, "text": "            left_sum += m"}, {"line": 9, "text": "            left_excess = left_sum - (i + 1) * target"}, {"line": 10, "text": "            right_excess = (len(machines) - i - 1) * target - (total - left_sum)"}, {"line": 11, "text": "            max_moves = max(max_moves, abs(left_excess), abs(right_excess), m - target)"}, {"line": 12, "text": "        return max_moves"]}}