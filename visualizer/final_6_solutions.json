{"trapping-rain-water-ii":[{"line":1,"text":"def trapRainWater(heightMap: list[list[int]]) -> int:"},{"line":2,"text":"    if not heightMap or not heightMap[0]: return 0"},{"line":3,"text":"    import heapq"},{"line":4,"text":"    m, n = len(heightMap), len(heightMap[0])"},{"line":5,"text":"    visited = [[False] * n for _ in range(m)]"},{"line":6,"text":"    heap = []"},{"line":7,"text":"    for i in range(m):"},{"line":8,"text":"        for j in [0, n-1]:"},{"line":9,"text":"            heapq.heappush(heap, (heightMap[i][j], i, j))"},{"line":10,"text":"            visited[i][j] = True"},{"line":11,"text":"    for j in range(n):"},{"line":12,"text":"        for i in [0, m-1]:"},{"line":13,"text":"            heapq.heappush(heap, (heightMap[i][j], i, j))"},{"line":14,"text":"            visited[i][j] = True"},{"line":15,"text":"    water = 0"},{"line":16,"text":"    while heap:"},{"line":17,"text":"        h, x, y = heapq.heappop(heap)"},{"line":18,"text":"        for dx, dy in [(0, 1), (0, -1), (1, 0), (-1, 0)]:"},{"line":19,"text":"            nx, ny = x + dx, y + dy"},{"line":20,"text":"            if 0 <= nx < m and 0 <= ny < n and not visited[nx][ny]:"},{"line":21,"text":"                water += max(0, h - heightMap[nx][ny])"},{"line":22,"text":"                visited[nx][ny] = True"},{"line":23,"text":"                heapq.heappush(heap, (max(h, heightMap[nx][ny]), nx, ny))"},{"line":24,"text":"    return water"}],"minimum-unique-word-abbreviation":[{"line":1,"text":"def minAbbreviation(target: str, dictionary: list[str]) -> str:"},{"line":2,"text":"    def isUnique(abbr):"},{"line":3,"text":"        for word in dictionary:"},{"line":4,"text":"            if len(word) != len(target): continue"},{"line":5,"text":"            match = True"},{"line":6,"text":"            i = j = 0"},{"line":7,"text":"            while i < len(abbr):"},{"line":8,"text":"                if abbr[i].isdigit():"},{"line":9,"text":"                    k = int(abbr[i])"},{"line":10,"text":"                    while i < len(abbr) and abbr[i].isdigit():"},{"line":11,"text":"                        k = k * 10 + int(abbr[i])"},{"line":12,"text":"                        i += 1"},{"line":13,"text":"                    j += k"},{"line":14,"text":"                else:"},{"line":15,"text":"                    if abbr[i] != word[j]: match = False; break"},{"line":16,"text":"                    i += 1; j += 1"},{"line":17,"text":"            if match and j == len(word): return False"},{"line":18,"text":"        return True"},{"line":19,"text":"    def dfs(idx, abbr):"},{"line":20,"text":"        if idx == len(target):"},{"line":21,"text":"            return abbr if isUnique(abbr) else None"},{"line":22,"text":"        res = dfs(idx + 1, abbr + target[idx])"},{"line":23,"text":"        if res: return res"},{"line":24,"text":"        num = 1"},{"line":25,"text":"        while idx + num < len(target):"},{"line":26,"text":"            res = dfs(idx + num, abbr + str(num))"},{"line":27,"text":"            if res: return res"},{"line":28,"text":"            num += 1"},{"line":29,"text":"        return None"},{"line":30,"text":"    return dfs(0, \"\")"}],"sentence-screen-fitting":[{"line":1,"text":"def wordsTyping(sentence: list[str], rows: int, cols: int) -> int:"},{"line":2,"text":"    screen = \" \".join(sentence) + \" \""},{"line":3,"text":"    screenLen = len(screen)"},{"line":4,"text":"    pos = 0"},{"line":5,"text":"    for _ in range(rows):"},{"line":6,"text":"        pos += cols"},{"line":7,"text":"        if screen[pos % screenLen] == \" \":"},{"line":8,"text":"            pos += 1"},{"line":9,"text":"        else:"},{"line":10,"text":"            while pos > 0 and screen[(pos - 1) % screenLen] != \" \":"},{"line":11,"text":"                pos -= 1"},{"line":12,"text":"    return pos // screenLen"}],"verbal-arithmetic-puzzle":[{"line":1,"text":"def isSolvable(equations: list[str]) -> bool:"},{"line":2,"text":"    eq = equations[0].split('=')"},{"line":3,"text":"    sumWords = eq[0].split('+')"},{"line":4,"text":"    resultWord = eq[1]"},{"line":5,"text":"    chars = set(''.join(sumWords) + resultWord)"},{"line":6,"text":"    firstChars = {w[0] for w in sumWords + [resultWord] if w}"},{"line":7,"text":"    def dfs(idx, mapping, used):"},{"line":8,"text":"        if idx == len(chars):"},{"line":9,"text":"            total = sum(int(''.join(str(mapping.get(c, 0)) for c in w)) for w in sumWords)"},{"line":10,"text":"            result = int(''.join(str(mapping.get(c, 0)) for c in resultWord))"},{"line":11,"text":"            return total == result"},{"line":12,"text":"        char = list(chars)[idx]"},{"line":13,"text":"        for digit in range(10):"},{"line":14,"text":"            if digit == 0 and char in firstChars: continue"},{"line":15,"text":"            if digit not in used:"},{"line":16,"text":"                mapping[char] = digit"},{"line":17,"text":"                if dfs(idx + 1, mapping, used | {digit}): return True"},{"line":18,"text":"                del mapping[char]"},{"line":19,"text":"        return False"},{"line":20,"text":"    return dfs(0, {}, set())"}],"expression-tree-from-tokens":[{"line":1,"text":"def build(tokens: list[str]):"},{"line":2,"text":"    class Node:"},{"line":3,"text":"        def __init__(self, val): self.val = val; self.left = self.right = None"},{"line":4,"text":"    stack = []"},{"line":5,"text":"    for token in tokens:"},{"line":6,"text":"        if token in '+-*/:"},{"line":7,"text":"            node = Node(token)"},{"line":8,"text":"            node.right = stack.pop()"},{"line":9,"text":"            node.left = stack.pop()"},{"line":10,"text":"            stack.append(node)"},{"line":11,"text":"        else:"},{"line":12,"text":"            stack.append(Node(int(token)))"},{"line":13,"text":"    return stack[0]"}],"find-all-anagrams-in-string":[{"line":1,"text":"def findAnagrams(s: str, p: str) -> list[int]:"},{"line":2,"text":"    if len(p) > len(s): return []"},{"line":3,"text":"    pCount = {}"},{"line":4,"text":"    for c in p: pCount[c] = pCount.get(c, 0) + 1"},{"line":5,"text":"    window = {}"},{"line":6,"text":"    result = []"},{"line":7,"text":"    for i in range(len(s)):"},{"line":8,"text":"        c = s[i]"},{"line":9,"text":"        window[c] = window.get(c, 0) + 1"},{"line":10,"text":"        if i >= len(p):"},{"line":11,"text":"            old = s[i - len(p)]"},{"line":12,"text":"            window[old] -= 1"},{"line":13,"text":"            if window[old] == 0: del window[old]"},{"line":14,"text":"        if window == pCount: result.append(i - len(p) + 1)"},{"line":15,"text":"    return result"}]}
