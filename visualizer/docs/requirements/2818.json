  "summary": "Start with score 1; at most k operations, each picks an unused subarray and multiplies score by the element with the largest prime score (distinct prime factor count), ties to smaller index. Return max score mod 1e9+7.",
  "officialConstraints": [
    "1 <= n = nums.length <= 10^5",
    "1 <= nums[i] <= 10^5",
    "1 <= k <= min(n(n+1)/2, 10^9)"
  ],
  "examples": [
    {
      "input": {
        "nums": [
          8,
          3,
          9,
          3,
          8
        ],
        "k": 2
      },
      "output": 81
    },
    {
      "input": {
        "nums": [
          19,
          12,
          14,
          6,
          10,
          18
        ],
        "k": 3
      },
      "output": 4788
    }
