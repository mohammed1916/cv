  "statement": "arr is a permutation of 1..n; step i sets bit arr[i] to 1 in an n-zero string. Return the latest step where a run of ones of length exactly m exists, or -1.",
  "constraints": [
    "n == arr.length",
    "1 <= m <= n <= 10^5",
    "1 <= arr[i] <= n",
    "all arr[i] distinct"
  ],
  "examples": [
    {
      "input": "arr=[3,5,1,2,4], m=1",
      "output": 4
    },
    {
      "input": "arr=[3,1,5,4,2], m=2",
      "output": -1
    }
  ],
