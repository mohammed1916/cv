  "summary": "Rearrange nums by swapping any pair of distinct positions. Minimize the number of swaps so that every resulting value differs from forbidden at the same position. Return -1 when impossible.",
  "officialConstraints": "Both arrays have the same length, 1 through 100000. Every value is an integer from 1 through 1000000000.",
  "examples": [
    {
      "input": {
        "nums": [
          1,
          2,
          3
        ],
        "forbidden": [
          3,
          2,
          1
        ]
      },
      "output": 1
    },
    {
      "input": {
        "nums": [
          4,
          6,
          6,
          5
        ],
        "forbidden": [
          4,
          6,
          5,
          5
        ]
      },
      "output": 2
    },
    {
      "input": {
        "nums": [
          7,
          7
        ],
        "forbidden": [
          8,
          7
        ]
      },
      "output": -1
    },
    {
      "input": {
        "nums": [
          1,
          2
        ],
        "forbidden": [
          2,
          1
        ]
      },
      "output": 0
    }
  ],
  "pitfalls": [
    "forbidden never changes. Swaps need not be adjacent. Duplicate values are allowed."
