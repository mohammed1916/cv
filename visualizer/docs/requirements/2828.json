  "summary": "Return true if s equals the first letters of words concatenated in order.",
  "officialConstraints": [
    "1 <= words.length <= 100",
    "1 <= words[i].length <= 10",
    "1 <= s.length <= 100",
    "words[i] and s contain only lowercase English letters"
  ],
  "examples": [
    {
      "input": {
        "words": [
          "alice",
          "bob",
          "charlie"
        ],
        "s": "abc"
      },
      "output": true
    },
    {
      "input": {
        "words": [
          "an",
          "apple"
        ],
        "s": "a"
      },
      "output": false
    },
    {
      "input": {
        "words": [
          "never",
          "gonna",
          "give",
          "up",
          "on",
          "you"
        ],
        "s": "ngguoy"
      },
      "output": true
    }
