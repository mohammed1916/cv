    },
    {
      "line": 8,
      "text": "            l, r = i, i"
    },
    {
      "line": 9,
      "text": "            while l >= 0 and r < len(s) and s[l] == s[r]:"
    },
    {
      "line": 10,
      "text": "                if (r - l + 1) > resLen:"
    },
    {
      "line": 11,
      "text": "                    res = s[l:r+1]"
    },
    {
      "line": 12,
      "text": "                    resLen = r - l + 1"
    },
    {
      "line": 13,
      "text": "                l -= 1"
    },
    {
      "line": 14,
      "text": "                r += 1"
    },
    {
      "line": 15,
      "text": "                "
    },
    {
      "line": 16,
      "text": "            # even length"
    },
    {
      "line": 17,
      "text": "            l, r = i, i + 1"
    },
    {
      "line": 18,
      "text": "            while l >= 0 and r < len(s) and s[l] == s[r]:"
    },
    {
      "line": 19,
      "text": "                if (r - l + 1) > resLen:"
    },
    {
      "line": 20,
