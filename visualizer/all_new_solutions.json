{
  "add-binary": [
    {
      "line": 1,
      "text": "def addBinary(a, b):"
    },
    {
      "line": 2,
      "text": "    i, j = len(a) - 1, len(b) - 1"
    },
    {
      "line": 3,
      "text": "    carry = 0"
    },
    {
      "line": 4,
      "text": "    result = []"
    },
    {
      "line": 5,
      "text": "    while i >= 0 or j >= 0 or carry:"
    },
    {
      "line": 6,
      "text": "        a_bit = int(a[i]) if i >= 0 else 0"
    },
    {
      "line": 7,
      "text": "        b_bit = int(b[j]) if j >= 0 else 0"
    },
    {
      "line": 8,
      "text": "        total = a_bit + b_bit + carry"
    },
    {
      "line": 9,
      "text": "        result.append(str(total % 2))"
    },
    {
      "line": 10,
      "text": "        carry = total // 2"
    },
    {
      "line": 11,
      "text": "        i, j = i - 1, j - 1"
    },
    {
      "line": 12,
      "text": "    return ''.join(reversed(result))"
    }
  ],
  "coin-change-2": [
    {
      "line": 1,
      "text": "class Solution:"
    },
    {
      "line": 2,
      "text": "    def coinChange(self, coins: List[int], amount: int) -> int:"
    },
    {
      "line": 3,
      "text": "        dp = [float(\"inf\")] * (amount + 1)"
    },
    {
      "line": 4,
      "text": "        dp[0] = 0"
    },
    {
      "line": 5,
      "text": ""
    },
    {
      "line": 6,
      "text": "        for a in range(1, amount + 1):"
    },
    {
      "line": 7,
      "text": "            for c in coins:"
    },
    {
      "line": 8,
      "text": "                if c <= a:"
    },
    {
      "line": 9,
      "text": "                    dp[a] = min(dp[a], dp[a - c] + 1)"
    },
    {
      "line": 10,
      "text": ""
    },
    {
      "line": 11,
      "text": "        return dp[amount] if dp[amount] != float(\"inf\") else -1"
    }
  ],
  "continuous-subarray-sum": [
    {
      "line": 1,
      "text": "def checkSubarraySum(nums, k):"
    },
    {
      "line": 2,
      "text": "    if k == 0:"
    },
    {
      "line": 3,
      "text": "        for i in range(len(nums) - 1):"
    },
    {
      "line": 4,
      "text": "            if nums[i] == 0 and nums[i + 1] == 0:"
    },
    {
      "line": 5,
      "text": "                return True"
    },
    {
      "line": 6,
      "text": "        return False"
    },
    {
      "line": 7,
      "text": "    sumMod = {0: -1}"
    },
    {
      "line": 8,
      "text": "    prefixSum = 0"
    },
    {
      "line": 9,
      "text": "    for i, num in enumerate(nums):"
    },
    {
      "line": 10,
      "text": "        prefixSum += num"
    },
    {
      "line": 11,
      "text": "        mod = ((prefixSum % k) + k) % k"
    },
    {
      "line": 12,
      "text": "        if mod in sumMod and i - sumMod[mod] >= 2:"
    },
    {
      "line": 13,
      "text": "            return True"
    },
    {
      "line": 14,
      "text": "        if mod not in sumMod:"
    },
    {
      "line": 15,
      "text": "            sumMod[mod] = i"
    },
    {
      "line": 16,
      "text": "    return False"
    }
  ],
