  "freedom-trail": [
    {
      "line": 1,
      "text": "def freedomTrail(ring, key):"
    },
    {
      "line": 2,
      "text": "    memo = {}"
    },
    {
      "line": 3,
      "text": "    def dp(pos, keyIdx):"
    },
    {
      "line": 4,
      "text": "        if keyIdx == len(key): return 0"
    },
    {
      "line": 5,
      "text": "        if (pos, keyIdx) in memo: return memo[(pos, keyIdx)]"
    },
    {
      "line": 6,
      "text": "        target = key[keyIdx]"
    },
    {
      "line": 7,
      "text": "        min_steps = float('inf')"
    },
    {
      "line": 8,
      "text": "        for i, ch in enumerate(ring):"
    },
    {
      "line": 9,
      "text": "            if ch == target:"
    },
    {
      "line": 10,
      "text": "                clockwise = (i - pos) % len(ring)"
    },
    {
      "line": 11,
      "text": "                counter = (pos - i) % len(ring)"
    },
    {
      "line": 12,
      "text": "                dist = min(clockwise, counter)"
    },
    {
      "line": 13,
      "text": "                min_steps = min(min_steps, dist + 1 + dp(i, keyIdx + 1))"
    },
    {
      "line": 14,
      "text": "        memo[(pos, keyIdx)] = min_steps"
    },
    {
      "line": 15,
      "text": "        return min_steps"
    },
    {
      "line": 16,
      "text": "    return dp(0, 0)"
    }
  ],
