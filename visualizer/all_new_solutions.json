  "distribute-candies-to-people": [
    {
      "line": 1,
      "text": "def distributeCandies(candies, num_people):"
    },
    {
      "line": 2,
      "text": "    result = [0] * num_people"
    },
    {
      "line": 3,
      "text": "    allocation = 1"
    },
    {
      "line": 4,
      "text": "    i = 0"
    },
    {
      "line": 5,
      "text": "    while candies > 0:"
    },
    {
      "line": 6,
      "text": "        result[i % num_people] += min(allocation, candies)"
    },
    {
      "line": 7,
      "text": "        candies -= min(allocation, candies)"
    },
    {
      "line": 8,
      "text": "        allocation += 1"
    },
    {
      "line": 9,
      "text": "        i += 1"
    },
    {
      "line": 10,
      "text": "    return result"
    }
  ],
  "fibonacci-number": [
    {
      "line": 1,
      "text": "def fib(n):"
    },
    {
      "line": 2,
      "text": "    if n == 0: return 0"
    },
    {
      "line": 3,
      "text": "    if n == 1: return 1"
    },
    {
      "line": 4,
      "text": "    dp = [0] * (n + 1)"
    },
    {
      "line": 5,
      "text": "    dp[1] = 1"
    },
    {
      "line": 6,
      "text": "    for i in range(2, n + 1):"
    },
    {
      "line": 7,
      "text": "        dp[i] = dp[i - 1] + dp[i - 2]"
    },
    {
      "line": 8,
      "text": "    return dp[n]"
    }
  ],
  "find-all-anagrams-in-a-string": [
    {
      "line": 1,
      "text": "def findAnagrams(s, p):"
    },
    {
      "line": 2,
      "text": "    need = Counter(p)"
    },
    {
      "line": 3,
      "text": "    have = Counter(s[:len(p)])"
    },
    {
      "line": 4,
      "text": "    result = []"
    },
    {
      "line": 5,
      "text": "    if have == need: result.append(0)"
    },
    {
      "line": 6,
      "text": "    for i in range(len(p), len(s)):"
    },
    {
      "line": 7,
      "text": "        have[s[i]] += 1"
    },
    {
      "line": 8,
      "text": "        have[s[i-len(p)]] -= 1"
    },
    {
      "line": 9,
      "text": "        if have[s[i-len(p)]] == 0: del have[s[i-len(p)]]"
    },
    {
      "line": 10,
      "text": "        winStart = i - len(p) + 1"
    },
    {
      "line": 11,
      "text": "        if have == need: result.append(winStart)"
    },
    {
      "line": 12,
      "text": "    return result"
    }
  ],
  "find-bottom-left-tree-value": [
    {
      "line": 1,
      "text": "def findBottomLeftValue(root):"
    },
    {
      "line": 2,
      "text": "    if not root: return None"
    },
    {
      "line": 3,
      "text": "    queue = [root]"
    },
    {
      "line": 4,
      "text": "    bottomLeft = root.val"
    },
    {
      "line": 5,
      "text": "    while queue:"
    },
    {
      "line": 6,
      "text": "        level_size = len(queue)"
    },
    {
      "line": 7,
      "text": "        for i in range(level_size):"
    },
    {
      "line": 8,
      "text": "            node = queue.pop(0)"
    },
    {
      "line": 9,
      "text": "            if i == 0: bottomLeft = node.val"
    },
    {
      "line": 10,
      "text": "            if node.left: queue.append(node.left)"
    },
    {
      "line": 11,
      "text": "            if node.right: queue.append(node.right)"
    },
    {
      "line": 12,
      "text": "    return bottomLeft"
    }
  ],
