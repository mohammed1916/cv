  "largest-palindrome-product": [
    {
      "line": 1,
      "text": "def largestPalindrome(n):"
    },
    {
      "line": 2,
      "text": "    if n == 1: return 9"
    },
    {
      "line": 3,
      "text": "    upper = 10 ** n - 1"
    },
    {
      "line": 4,
      "text": "    lower = 10 ** (n - 1)"
    },
    {
      "line": 5,
      "text": "    for palindrome in range(upper * upper, 0, -1):"
    },
    {
      "line": 6,
      "text": "        s = str(palindrome)"
    },
    {
      "line": 7,
      "text": "        if s == s[::-1]:"
    },
    {
      "line": 8,
      "text": "            for i in range(upper, lower - 1, -1):"
    },
    {
      "line": 9,
      "text": "                if palindrome % i == 0 and lower <= palindrome // i <= upper: return palindrome"
    }
  ],
  "sliding-window-median": [
    {
      "line": 1,
      "text": "def medianSlidingWindow(nums, k):"
    },
    {
      "line": 2,
      "text": "    import bisect"
    },
    {
      "line": 3,
      "text": "    window, result = [], []"
    },
    {
      "line": 4,
      "text": "    for i in range(len(nums)):"
    },
    {
      "line": 5,
      "text": "        if i >= k: window.remove(nums[i - k])"
    },
    {
      "line": 6,
      "text": "        bisect.insort(window, nums[i])"
    },
    {
      "line": 7,
      "text": "        if i >= k - 1:"
    },
    {
      "line": 8,
      "text": "            median = (window[k // 2 - 1] + window[k // 2]) / 2 if k % 2 == 0 else window[k // 2]"
    },
    {
      "line": 9,
      "text": "            result.append(median)"
    },
    {
      "line": 10,
      "text": "    return result"
    }
  ],
