  "count-the-repetitions": [
    {
      "line": 1,
      "text": "def getMaxRepetitions(s1, n1, s2, n2):"
    },
    {
      "line": 2,
      "text": "    s2_count, s2_idx = 0, 0"
    },
    {
      "line": 3,
      "text": "    for _ in range(n1):"
    },
    {
      "line": 4,
      "text": "        for char in s1:"
    },
    {
      "line": 5,
      "text": "            if char == s2[s2_idx]: s2_idx += 1"
    },
    {
      "line": 6,
      "text": "            if s2_idx == len(s2): s2_count += 1; s2_idx = 0"
    },
    {
      "line": 7,
      "text": "    return s2_count // n2"
    }
  ],
  "unique-substrings-in-wraparound-string": [
    {
      "line": 1,
      "text": "def findSubstringInWraproundString(s):"
    },
    {
      "line": 2,
      "text": "    char_len, length = {}, 1"
    },
    {
      "line": 3,
      "text": "    for i in range(len(s)):"
    },
    {
      "line": 4,
      "text": "        if i > 0 and (ord(s[i]) - ord(s[i-1])) % 26 == 1: length += 1"
    },
    {
      "line": 5,
      "text": "        else: length = 1"
    },
    {
      "line": 6,
      "text": "        char_len[s[i]] = max(char_len.get(s[i], 0), length)"
    },
    {
      "line": 7,
      "text": "    return sum(char_len.values())"
    }
  ],
  "validate-ip-address": [
    {
      "line": 1,
      "text": "def validIPAddress(ip):"
    },
    {
      "line": 2,
      "text": "    if '.' in ip:"
    },
    {
      "line": 3,
      "text": "        parts = ip.split('.')"
    },
    {
      "line": 4,
      "text": "        if len(parts) != 4: return 'Neither'"
    },
    {
      "line": 5,
      "text": "        for p in parts:"
    },
    {
      "line": 6,
      "text": "            if not p or len(p) > 3 or (p[0] == '0' and len(p) > 1) or not p.isdigit() or int(p) > 255: return 'Neither'"
    },
    {
      "line": 7,
      "text": "        return 'IPv4'"
    },
    {
      "line": 8,
      "text": "    parts = ip.split(':')"
    },
    {
      "line": 9,
      "text": "    if len(parts) != 8: return 'Neither'"
    },
    {
      "line": 10,
      "text": "    for p in parts:"
    },
    {
      "line": 11,
      "text": "        if not p or len(p) > 4 or not all(c in '0123456789abcdefABCDEF' for c in p): return 'Neither'"
    },
    {
      "line": 12,
      "text": "    return 'IPv6'"
    }
  ],
  "convex-polygon": [
    {
      "line": 1,
      "text": "def isConvexPolygon(points):"
    },
    {
      "line": 2,
      "text": "    if len(points) < 3: return False"
    },
    {
      "line": 3,
      "text": "    def cross(o, a, b): return (a[0]-o[0])*(b[1]-o[1]) - (a[1]-o[1])*(b[0]-o[0])"
    },
    {
      "line": 4,
      "text": "    sign = None"
    },
    {
      "line": 5,
      "text": "    for i in range(len(points)):"
    },
    {
      "line": 6,
      "text": "        cp = cross(points[i], points[(i+1)%len(points)], points[(i+2)%len(points)])"
    },
    {
      "line": 7,
      "text": "        if cp != 0:"
    },
    {
      "line": 8,
      "text": "            if sign is None: sign = cp > 0"
    },
    {
      "line": 9,
      "text": "            elif (cp > 0) != sign: return False"
    },
    {
      "line": 10,
      "text": "    return True"
    }
  ],
