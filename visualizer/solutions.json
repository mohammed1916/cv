  "reverse-pairs": [
    {
      "line": 1,
      "text": "def reversePairs(nums):"
    },
    {
      "line": 2,
      "text": "    def merge_count(arr):"
    },
    {
      "line": 3,
      "text": "        if len(arr) <= 1: return 0, arr"
    },
    {
      "line": 4,
      "text": "        mid = len(arr) // 2"
    },
    {
      "line": 5,
      "text": "        l_inv, l = merge_count(arr[:mid])"
    },
    {
      "line": 6,
      "text": "        r_inv, r = merge_count(arr[mid:])"
    },
    {
      "line": 7,
      "text": "        inv = l_inv + r_inv"
    },
    {
      "line": 8,
      "text": "        i = j = 0"
    },
    {
      "line": 9,
      "text": "        while i < len(l) and j < len(r):"
    },
    {
      "line": 10,
      "text": "            if l[i] > 2 * r[j]: inv += len(l) - i; j += 1"
    },
    {
      "line": 11,
      "text": "            else: i += 1"
    },
    {
      "line": 12,
      "text": "        return inv, sorted(l + r)"
    },
    {
      "line": 13,
      "text": "    return merge_count(nums)[0]"
    }
  ],
  "target-sum": [
    {
      "line": 1,
      "text": "def findTargetSumWays(nums, target):"
    },
    {
      "line": 2,
      "text": "    total = sum(nums)"
    },
    {
      "line": 3,
      "text": "    if total < abs(target) or (total + target) % 2 != 0: return 0"
    },
    {
      "line": 4,
      "text": "    subset_sum = (total + target) // 2"
    },
    {
      "line": 5,
      "text": "    dp = [0] * (subset_sum + 1)"
    },
    {
      "line": 6,
      "text": "    dp[0] = 1"
    },
    {
      "line": 7,
      "text": "    for num in nums:"
    },
    {
      "line": 8,
      "text": "        for i in range(subset_sum, num - 1, -1): dp[i] += dp[i - num]"
    },
    {
      "line": 9,
      "text": "    return dp[subset_sum]"
    }
  ],
