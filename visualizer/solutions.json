      "text": "    dp[0][0] = True"
    },
    {
      "line": 4,
      "text": "    for i in range(2, len(p) + 1):"
    },
    {
      "line": 5,
      "text": "        if p[i - 1] == '*': dp[0][i] = dp[0][i - 2]"
    },
    {
      "line": 6,
      "text": "    for i in range(1, len(s) + 1):"
    },
    {
      "line": 7,
      "text": "        for j in range(1, len(p) + 1):"
    },
    {
      "line": 8,
      "text": "            if p[j - 1] in (s[i - 1], '.'): dp[i][j] = dp[i - 1][j - 1]"
    },
    {
      "line": 9,
      "text": "            elif p[j - 1] == '*': dp[i][j] = dp[i][j - 2] or (dp[i - 1][j] and p[j - 2] in (s[i - 1], '.'))"
    },
    {
      "line": 10,
      "text": "    return dp[len(s)][len(p)]"
    }
