  "encode-string-with-shortest-length": [
    {
      "line": 1,
      "text": "def getLengthOfOptimalCompression(s, k):"
    },
    {
      "line": 2,
      "text": "    memo = {}"
    },
    {
      "line": 3,
      "text": "    def dp(i, k, char, count):"
    },
    {
      "line": 4,
      "text": "        if i == len(s): return 0"
    },
    {
      "line": 5,
      "text": "        key = (i, k, char, count)"
    },
    {
      "line": 6,
      "text": "        if key in memo: return memo[key]"
    },
    {
      "line": 7,
      "text": "        res = dp(i + 1, k - 1, char, count) if k > 0 else float('inf')"
    },
    {
      "line": 8,
      "text": "        res2 = dp(i + 1, k, char, count + 1) if s[i] == char else (1 if char else 0) + dp(i + 1, k, s[i], 1)"
    },
    {
      "line": 9,
      "text": "        memo[key] = min(res, res2)"
    },
    {
      "line": 10,
      "text": "        return memo[key]"
    },
    {
      "line": 11,
      "text": "    return dp(0, k, '', 0)"
    }
  ],
  "concatenated-words": [
    {
      "line": 1,
      "text": "def findAllConcatenatedWordsInADict(words):"
    },
    {
      "line": 2,
      "text": "    word_set = set(words)"
    },
    {
      "line": 3,
      "text": "    def can_break(word, start, count):"
    },
    {
      "line": 4,
      "text": "        if start == len(word): return count >= 2"
    },
    {
      "line": 5,
      "text": "        for end in range(start + 1, len(word) + 1):"
    },
    {
      "line": 6,
      "text": "            if word[start:end] in word_set and can_break(word, end, count + 1): return True"
    },
    {
      "line": 7,
      "text": "        return False"
    },
    {
      "line": 8,
      "text": "    result = []"
    },
    {
      "line": 9,
      "text": "    for word in words:"
    },
    {
      "line": 10,
      "text": "        word_set.discard(word)"
    },
    {
      "line": 11,
      "text": "        if can_break(word, 0, 0): result.append(word)"
    },
    {
      "line": 12,
      "text": "        word_set.add(word)"
    },
    {
      "line": 13,
      "text": "    return result"
    }
  ],
  "matchsticks-to-square": [
    {
      "line": 1,
      "text": "def makesquare(matchsticks):"
    },
    {
      "line": 2,
      "text": "    if len(matchsticks) < 4 or sum(matchsticks) % 4 != 0: return False"
    },
    {
      "line": 3,
      "text": "    side = sum(matchsticks) // 4"
    },
    {
      "line": 4,
      "text": "    sides = [0] * 4"
    },
    {
      "line": 5,
      "text": "    matchsticks.sort(reverse=True)"
    },
    {
      "line": 6,
      "text": "    def backtrack(idx):"
    },
    {
      "line": 7,
      "text": "        if idx == len(matchsticks): return all(s == side for s in sides)"
    },
    {
      "line": 8,
      "text": "        for i in range(4):"
    },
    {
      "line": 9,
      "text": "            if sides[i] + matchsticks[idx] <= side:"
    },
    {
      "line": 10,
      "text": "                sides[i] += matchsticks[idx]"
    },
    {
      "line": 11,
      "text": "                if backtrack(idx + 1): return True"
    },
    {
      "line": 12,
      "text": "                sides[i] -= matchsticks[idx]"
    },
    {
      "line": 13,
      "text": "        return False"
    },
    {
      "line": 14,
      "text": "    return backtrack(0)"
    }
  ],
  "ones-and-zeroes": [
    {
      "line": 1,
      "text": "def findMaxForm(strs, m, n):"
    },
    {
      "line": 2,
      "text": "    dp = [[0] * (n + 1) for _ in range(m + 1)]"
    },
    {
      "line": 3,
      "text": "    for s in strs:"
    },
    {
      "line": 4,
      "text": "        zeros, ones = s.count('0'), s.count('1')"
    },
    {
      "line": 5,
      "text": "        for i in range(m, zeros - 1, -1):"
    },
    {
      "line": 6,
      "text": "            for j in range(n, ones - 1, -1):"
    },
    {
      "line": 7,
      "text": "                dp[i][j] = max(dp[i][j], dp[i - zeros][j - ones] + 1)"
    },
    {
      "line": 8,
      "text": "    return dp[m][n]"
    }
  ],
  "heaters": [
    {
      "line": 1,
      "text": "def findRadius(houses, heaters):"
    },
    {
      "line": 2,
      "text": "    heaters.sort()"
    },
    {
      "line": 3,
      "text": "    max_radius = 0"
    },
    {
      "line": 4,
      "text": "    for house in houses:"
    },
    {
      "line": 5,
      "text": "        left, right = 0, len(heaters)"
    },
    {
      "line": 6,
      "text": "        while left < right: mid = (left + right) // 2"
    },
    {
      "line": 7,
      "text": "            if heaters[mid] < house: left = mid + 1"
    },
    {
      "line": 8,
      "text": "            else: right = mid"
    },
    {
      "line": 9,
      "text": "        r_dist = heaters[left] - house if left < len(heaters) else float('inf')"
    },
    {
      "line": 10,
      "text": "        l_dist = house - heaters[left - 1] if left > 0 else float('inf')"
    },
    {
      "line": 11,
      "text": "        max_radius = max(max_radius, min(l_dist, r_dist))"
    },
    {
      "line": 12,
      "text": "    return max_radius"
    }
  ],
  "number-complement": [
    {
      "line": 1,
      "text": "def findComplement(num):"
    },
    {
      "line": 2,
      "text": "    mask = 1"
    },
    {
      "line": 3,
      "text": "    while mask <= num: mask <<= 1"
    },
    {
      "line": 4,
      "text": "    return (mask - 1) ^ num"
    }
  ],
  "total-hamming-distance": [
    {
      "line": 1,
      "text": "def totalHammingDistance(nums):"
    },
    {
      "line": 2,
      "text": "    total = 0"
    },
    {
      "line": 3,
      "text": "    for i in range(32):"
