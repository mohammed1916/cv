  "predict-the-winner": [
    {
      "line": 1,
      "text": "def predictTheWinner(nums):"
    },
    {
      "line": 2,
      "text": "    memo = {}"
    },
    {
      "line": 3,
      "text": "    def maxDiff(l, r):"
    },
    {
      "line": 4,
      "text": "        if l > r: return 0"
    },
    {
      "line": 5,
      "text": "        if (l, r) in memo: return memo[(l, r)]"
    },
    {
      "line": 6,
      "text": "        d1 = nums[l] - maxDiff(l + 1, r)"
    },
    {
      "line": 7,
      "text": "        d2 = nums[r] - maxDiff(l, r - 1)"
    },
    {
      "line": 8,
      "text": "        memo[(l, r)] = max(d1, d2)"
    },
    {
      "line": 9,
      "text": "        return memo[(l, r)]"
    },
    {
      "line": 10,
      "text": "    return maxDiff(0, len(nums) - 1) >= 0"
    }
  ],
  "max-consecutive-ones-iii": [
    {
      "line": 1,
      "text": "def longestOnes(nums, k):"
    },
    {
      "line": 2,
      "text": "    left, flipped = 0, 0"
    },
    {
      "line": 3,
      "text": "    for right in range(len(nums)):"
    },
    {
      "line": 4,
      "text": "        if nums[right] == 0: flipped += 1"
    },
    {
      "line": 5,
      "text": "        if flipped > k:"
    },
    {
      "line": 6,
      "text": "            if nums[left] == 0: flipped -= 1"
    },
    {
      "line": 7,
      "text": "            left += 1"
    },
    {
      "line": 8,
      "text": "    return right - left + 1"
    }
  ],
  "zuma-game": [
    {
      "line": 1,
      "text": "def findMinStep(board, hand):"
    },
    {
      "line": 2,
      "text": "    memo = {}"
    },
    {
      "line": 3,
      "text": "    def dfs(board, hand):"
    },
    {
      "line": 4,
      "text": "        if not board: return 0"
    },
    {
      "line": 5,
      "text": "        if not hand: return -1"
    },
    {
      "line": 6,
      "text": "        key = (board, tuple(sorted(hand)))"
    },
    {
      "line": 7,
      "text": "        if key in memo: return memo[key]"
    },
    {
      "line": 8,
      "text": "        result = -1"
    },
    {
      "line": 9,
      "text": "        for i in range(len(board)):"
    },
    {
      "line": 10,
      "text": "            if board[i] in hand:"
    },
    {
      "line": 11,
      "text": "                new_hand = list(hand); new_hand.remove(board[i])"
    },
    {
      "line": 12,
      "text": "                new_board = board[:i] + board[i+1:]"
    },
    {
      "line": 13,
      "text": "                sub = dfs(new_board, ''.join(new_hand))"
    },
    {
      "line": 14,
      "text": "                if sub != -1: result = min(result, sub + 1) if result != -1 else sub + 1"
    },
    {
      "line": 15,
      "text": "        memo[key] = result"
    },
    {
      "line": 16,
      "text": "        return result"
    },
    {
      "line": 17,
      "text": "    return dfs(board, hand)"
    }
  ],
  "robot-room-cleaner": [
    {
      "line": 1,
      "text": "def cleanRoom(robot):"
    },
    {
      "line": 2,
      "text": "    visited = set()"
    },
    {
      "line": 3,
      "text": "    dirs = [(0, -1), (-1, 0), (0, 1), (1, 0)]"
    },
    {
      "line": 4,
      "text": "    def backtrack(r, c, d_idx):"
    },
    {
      "line": 5,
      "text": "        visited.add((r, c))"
    },
    {
      "line": 6,
      "text": "        robot.clean()"
    },
    {
      "line": 7,
      "text": "        for _ in range(4):"
    },
    {
      "line": 8,
      "text": "            dr, dc = dirs[d_idx]"
    },
    {
      "line": 9,
      "text": "            if (r + dr, c + dc) not in visited and robot.move(): backtrack(r + dr, c + dc, d_idx)"
    },
    {
      "line": 10,
      "text": "            robot.turnRight(); d_idx = (d_idx + 1) % 4"
    },
    {
      "line": 11,
      "text": "    backtrack(0, 0, 1)"
    }
  ],
  "the-maze": [
    {
      "line": 1,
      "text": "def hasPath(maze, start, destination):"
    },
    {
      "line": 2,
      "text": "    from collections import deque"
    },
    {
      "line": 3,
      "text": "    queue, visited = deque([tuple(start)]), {tuple(start)}"
    },
    {
      "line": 4,
      "text": "    dirs = [(0, 1), (0, -1), (1, 0), (-1, 0)]"
    },
    {
      "line": 5,
      "text": "    while queue:"
    },
    {
      "line": 6,
      "text": "        r, c = queue.popleft()"
    },
    {
      "line": 7,
      "text": "        if r == destination[0] and c == destination[1]: return True"
    },
    {
      "line": 8,
      "text": "        for dr, dc in dirs:"
    },
    {
      "line": 9,
      "text": "            nr, nc = r + dr, c + dc"
    },
    {
      "line": 10,
      "text": "            while 0 <= nr < len(maze) and 0 <= nc < len(maze[0]) and maze[nr][nc] == 0: nr, nc = nr + dr, nc + dc"
    },
    {
      "line": 11,
      "text": "            nr, nc = nr - dr, nc - dc"
    },
    {
      "line": 12,
      "text": "            if (nr, nc) not in visited: visited.add((nr, nc)); queue.append((nr, nc))"
    },
    {
      "line": 13,
      "text": "    return False"
    }
  ],
