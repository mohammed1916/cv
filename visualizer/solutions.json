      "line": 4,
      "text": "        ones = sum((num >> i) & 1 for num in nums)"
    },
    {
      "line": 5,
      "text": "        zeros = len(nums) - ones"
    },
    {
      "line": 6,
      "text": "        total += ones * zeros"
    },
    {
      "line": 7,
      "text": "    return total"
    }
