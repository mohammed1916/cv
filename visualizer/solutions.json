  "relative-ranks": [
    {
      "line": 1,
      "text": "def findRelativeRanks(score):"
    },
    {
      "line": 2,
      "text": "    indices = sorted(range(len(score)), key=lambda i: -score[i])"
    },
    {
      "line": 3,
      "text": "    result = [''] * len(score)"
    },
    {
      "line": 4,
      "text": "    medals = ['Gold Medal', 'Silver Medal', 'Bronze Medal']"
    },
    {
      "line": 5,
      "text": "    for rank, idx in enumerate(indices): result[idx] = medals[rank] if rank < 3 else str(rank + 1)"
    },
    {
      "line": 6,
      "text": "    return result"
    }
  ],
  "scramble-string": [
    {
      "line": 1,
      "text": "def isScramble(s1, s2):"
    },
    {
      "line": 2,
      "text": "    memo = {}"
    },
    {
      "line": 3,
      "text": "    def helper(s1, s2):"
    },
    {
      "line": 4,
      "text": "        if s1 == s2: return True"
    },
    {
      "line": 5,
      "text": "        if sorted(s1) != sorted(s2): return False"
    },
    {
      "line": 6,
      "text": "        if (s1, s2) in memo: return memo[(s1, s2)]"
    },
    {
      "line": 7,
      "text": "        n = len(s1)"
    },
    {
      "line": 8,
      "text": "        for i in range(1, n):"
    },
    {
      "line": 9,
      "text": "            if (helper(s1[:i], s2[:i]) and helper(s1[i:], s2[i:])) or (helper(s1[:i], s2[-i:]) and helper(s1[i:], s2[:-i])):"
    },
    {
      "line": 10,
      "text": "                return memo.setdefault((s1, s2), True)"
    },
    {
      "line": 11,
      "text": "        memo[(s1, s2)] = False"
    },
    {
      "line": 12,
      "text": "        return False"
    },
    {
      "line": 13,
      "text": "    return helper(s1, s2)"
    }
  ],
  "search-a-2d-matrix": [
    {
      "line": 1,
      "text": "def searchMatrix(matrix, target):"
    },
    {
      "line": 2,
      "text": "    if not matrix or not matrix[0]: return False"
    },
    {
      "line": 3,
      "text": "    m, n = len(matrix), len(matrix[0])"
    },
    {
      "line": 4,
      "text": "    left, right = 0, m * n - 1"
    },
    {
      "line": 5,
      "text": "    while left <= right:"
    },
    {
      "line": 6,
      "text": "        mid = (left + right) // 2"
    },
    {
      "line": 7,
      "text": "        mid_val = matrix[mid // n][mid % n]"
    },
    {
      "line": 8,
      "text": "        if mid_val == target: return True"
    },
    {
      "line": 9,
      "text": "        elif mid_val < target: left = mid + 1"
    },
    {
      "line": 10,
      "text": "        else: right = mid - 1"
    },
    {
      "line": 11,
      "text": "    return False"
    }
  ]
