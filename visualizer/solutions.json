{
  "minimum-genetic-mutation": [
    {
      "line": 1,
      "text": "def minMutation(start, end, bank):"
    },
    {
      "line": 2,
      "text": "    if end not in bank: return -1"
    },
    {
      "line": 3,
      "text": "    bank_set, queue, visited = set(bank), [(start, 0)], {start}"
    },
    {
      "line": 4,
      "text": "    while queue:"
    },
    {
      "line": 5,
      "text": "        current, steps = queue.pop(0)"
    },
    {
      "line": 6,
      "text": "        if current == end: return steps"
    },
    {
      "line": 7,
      "text": "        for i in range(len(current)):"
    },
    {
      "line": 8,
      "text": "            for gene in 'ACGT':"
    },
    {
      "line": 9,
      "text": "                mutated = current[:i] + gene + current[i+1:]"
    },
    {
      "line": 10,
      "text": "                if mutated in bank_set and mutated not in visited:"
    },
    {
      "line": 11,
      "text": "                    visited.add(mutated)"
    },
    {
      "line": 12,
      "text": "                    queue.append((mutated, steps + 1))"
    },
    {
      "line": 13,
      "text": "    return -1"
    }
  ],
  "number-of-islands-ii": [
    {
      "line": 1,
      "text": "def numIslands2(m, n, positions):"
    },
    {
      "line": 2,
      "text": "    parent = {}"
    },
    {
      "line": 3,
      "text": "    def find(x):"
    },
    {
      "line": 4,
      "text": "        if x not in parent: parent[x] = x"
    },
    {
      "line": 5,
      "text": "        if parent[x] != x: parent[x] = find(parent[x])"
    },
    {
      "line": 6,
      "text": "        return parent[x]"
    },
    {
      "line": 7,
      "text": "    def union(x, y):"
    },
    {
      "line": 8,
      "text": "        px, py = find(x), find(y)"
    },
    {
      "line": 9,
      "text": "        if px != py: parent[px] = py; return True"
    },
    {
      "line": 10,
      "text": "        return False"
    },
    {
      "line": 11,
      "text": "    result, island_count = [], 0"
    },
    {
      "line": 12,
      "text": "    for r, c in positions:"
    },
    {
      "line": 13,
      "text": "        find((r, c)); island_count += 1"
    },
    {
      "line": 14,
      "text": "        for dr, dc in [(0, 1), (0, -1), (1, 0), (-1, 0)]:"
    },
    {
      "line": 15,
      "text": "            nr, nc = r + dr, c + dc"
    },
    {
      "line": 16,
      "text": "            if 0 <= nr < m and 0 <= nc < n and (nr, nc) in parent:"
    },
    {
      "line": 17,
      "text": "                if union((r, c), (nr, nc)): island_count -= 1"
    },
    {
      "line": 18,
      "text": "        result.append(island_count)"
    },
    {
      "line": 19,
      "text": "    return result"
    }
  ],
  "find-right-interval": [
    {
      "line": 1,
      "text": "def findRightInterval(intervals):"
    },
    {
      "line": 2,
      "text": "    starts = sorted((interval[0], i) for i, interval in enumerate(intervals))"
    },
    {
      "line": 3,
      "text": "    result = []"
    },
    {
      "line": 4,
      "text": "    for end in (interval[1] for interval in intervals):"
    },
    {
      "line": 5,
      "text": "        left, right = 0, len(starts)"
    },
    {
      "line": 6,
      "text": "        while left < right:"
    },
    {
      "line": 7,
      "text": "            mid = (left + right) // 2"
    },
    {
      "line": 8,
      "text": "            if starts[mid][0] < end: left = mid + 1"
    },
    {
      "line": 9,
      "text": "            else: right = mid"
    },
    {
      "line": 10,
      "text": "        result.append(starts[left][1] if left < len(starts) else -1)"
    },
    {
      "line": 11,
      "text": "    return result"
    }
  ],
  "path-sum-iii": [
    {
      "line": 1,
      "text": "def pathSum(root, targetSum):"
    },
    {
      "line": 2,
      "text": "    count = [0]"
    },
    {
      "line": 3,
      "text": "    def dfs(node, current_sum):"
    },
    {
      "line": 4,
      "text": "        if not node: return"
    },
    {
      "line": 5,
      "text": "        current_sum += node.val"
    },
    {
      "line": 6,
      "text": "        if current_sum == targetSum: count[0] += 1"
    },
    {
      "line": 7,
      "text": "        dfs(node.left, current_sum)"
    },
    {
      "line": 8,
      "text": "        dfs(node.right, current_sum)"
    },
    {
      "line": 9,
      "text": "    def helper(node):"
    },
    {
      "line": 10,
      "text": "        if not node: return"
    },
    {
      "line": 11,
      "text": "        dfs(node, 0)"
    },
    {
      "line": 12,
      "text": "        helper(node.left)"
    },
    {
      "line": 13,
      "text": "        helper(node.right)"
    },
    {
      "line": 14,
      "text": "    helper(root)"
    },
    {
      "line": 15,
      "text": "    return count[0]"
    }
  ],
  "ternary-expression-parser": [
    {
      "line": 1,
      "text": "def parseTernary(expression):"
    },
    {
      "line": 2,
      "text": "    stack = []"
    },
    {
      "line": 3,
      "text": "    for i in range(len(expression) - 1, -1, -1):"
    },
    {
      "line": 4,
      "text": "        if expression[i] in 'tf': stack.append(expression[i])"
    },
    {
      "line": 5,
      "text": "        elif expression[i] == ':': pass"
    },
    {
      "line": 6,
      "text": "        elif expression[i] == '?':"
    },
    {
      "line": 7,
      "text": "            t, f, c = stack.pop(), stack.pop(), stack.pop()"
    },
    {
      "line": 8,
      "text": "            stack.append(t if c == 't' else f)"
    },
    {
      "line": 9,
      "text": "    return stack[0]"
    }
  ],
  "kth-smallest-lexicographical-order": [
    {
      "line": 1,
      "text": "def findKthNumber(n, k):"
    },
    {
      "line": 2,
      "text": "    def countSteps(n1, n2):"
    },
    {
      "line": 3,
      "text": "        steps = 0"
    },
    {
      "line": 4,
      "text": "        while n1 <= n: steps += min(n + 1, n2) - n1; n1 *= 10; n2 *= 10"
    },
    {
      "line": 5,
      "text": "        return steps"
    },
    {
      "line": 6,
      "text": "    current, k = 1, k - 1"
    },
    {
      "line": 7,
      "text": "    while k:"
    },
    {
      "line": 8,
      "text": "        steps = countSteps(current, current + 1)"
    },
    {
      "line": 9,
      "text": "        if steps <= k: current += 1; k -= steps"
    },
    {
      "line": 10,
      "text": "        else: current *= 10; k -= 1"
    },
    {
      "line": 11,
      "text": "    return current"
    }
  ],
  "arranging-coins": [
    {
      "line": 1,
      "text": "def arrangeCoins(n):"
    },
    {
      "line": 2,
      "text": "    left, right = 0, n"
    },
    {
      "line": 3,
      "text": "    while left <= right:"
    },
    {
      "line": 4,
      "text": "        mid = (left + right) // 2"
    },
    {
      "line": 5,
      "text": "        coins = mid * (mid + 1) // 2"
    },
    {
      "line": 6,
      "text": "        if coins <= n: left = mid + 1"
    },
    {
      "line": 7,
      "text": "        else: right = mid - 1"
    },
    {
      "line": 8,
      "text": "    return right"
    }
  ],
  "find-all-duplicates-in-array": [
    {
      "line": 1,
      "text": "def findDuplicates(nums):"
    },
    {
      "line": 2,
      "text": "    result = []"
    },
    {
      "line": 3,
      "text": "    for num in nums:"
    },
    {
      "line": 4,
      "text": "        idx = abs(num) - 1"
    },
    {
      "line": 5,
      "text": "        if nums[idx] < 0: result.append(abs(num))"
    },
    {
      "line": 6,
      "text": "        else: nums[idx] = -nums[idx]"
    },
    {
      "line": 7,
      "text": "    return result"
    }
  ],
  "string-compression": [
    {
      "line": 1,
      "text": "def compress(chars):"
    },
    {
      "line": 2,
      "text": "    write, read = 0, 0"
    },
    {
      "line": 3,
      "text": "    while read < len(chars):"
    },
    {
      "line": 4,
      "text": "        char, count = chars[read], 0"
    },
    {
      "line": 5,
      "text": "        while read < len(chars) and chars[read] == char: read += 1; count += 1"
    },
    {
      "line": 6,
      "text": "        chars[write] = char; write += 1"
    },
    {
      "line": 7,
      "text": "        if count > 1:"
    },
    {
      "line": 8,
      "text": "            for digit in str(count): chars[write] = digit; write += 1"
    },
    {
      "line": 9,
      "text": "    return write"
    }
  ],
  "sequence-reconstruction": [
    {
      "line": 1,
      "text": "def sequenceReconstruction(org, seqs):"
    },
    {
      "line": 2,
      "text": "    if not seqs: return False"
    },
    {
      "line": 3,
      "text": "    org_idx = {x: i for i, x in enumerate(org)}"
    },
    {
      "line": 4,
      "text": "    prev = -1"
    },
    {
      "line": 5,
      "text": "    for seq in seqs:"
    },
    {
      "line": 6,
      "text": "        for num in seq:"
    },
    {
      "line": 7,
      "text": "            if num not in org_idx or org_idx[num] != prev + 1: return False"
    },
    {
      "line": 8,
      "text": "            prev = org_idx[num]"
    },
    {
      "line": 9,
      "text": "    return prev == len(org) - 1"
    }
  ],
  "max-consecutive-ones": [
