  "the-maze-iii": [
    {
      "line": 1,
      "text": "def theMaze3(maze, ball, hole):"
    },
    {
      "line": 2,
      "text": "    import heapq"
    },
    {
      "line": 3,
      "text": "    m, n = len(maze), len(maze[0])"
    },
    {
      "line": 4,
      "text": "    dirs = [(0, 1, 'r'), (0, -1, 'l'), (1, 0, 'd'), (-1, 0, 'u')]"
    },
    {
      "line": 5,
      "text": "    pq, visited = [(0, '', ball[0], ball[1])], set()"
    },
    {
      "line": 6,
      "text": "    while pq:"
    },
    {
      "line": 7,
      "text": "        dist, path, x, y = heapq.heappop(pq)"
    },
    {
      "line": 8,
      "text": "        if [x, y] == hole: return path"
    },
    {
      "line": 9,
      "text": "        if (x, y) in visited: continue"
    },
    {
      "line": 10,
      "text": "        visited.add((x, y))"
    },
    {
      "line": 11,
      "text": "        for dx, dy, d in dirs:"
    },
    {
      "line": 12,
      "text": "            nx, ny, nd = x, y, 0"
    },
    {
      "line": 13,
      "text": "            while 0 <= nx + dx < m and 0 <= ny + dy < n and maze[nx + dx][ny + dy] == 0: nx, ny, nd = nx + dx, ny + dy, nd + 1"
    },
    {
      "line": 14,
      "text": "            if [nx, ny] == hole: heapq.heappush(pq, (dist + nd, path + d, nx, ny)); break"
    },
    {
      "line": 15,
      "text": "            else: heapq.heappush(pq, (dist + nd, path + d, nx, ny))"
    },
    {
      "line": 16,
      "text": "    return 'impossible'"
    }
  ],
